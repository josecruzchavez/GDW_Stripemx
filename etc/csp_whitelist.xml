<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="stripe-js" type="host">https://js.stripe.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="stripe-js" type="host">https://js.stripe.com</value>
                <value id="stripe-hooks" type="host">https://hooks.stripe.com</value>
                <value id="stripe-network" type="host">https://m.stripe.network</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="stripe-api" type="host">https://api.stripe.com</value>
                <value id="stripe-tracker" type="host">https://r.stripe.com</value>
                <value id="stripe-network" type="host">https://m.stripe.network</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
